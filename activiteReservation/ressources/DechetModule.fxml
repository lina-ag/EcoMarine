<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DechetModuleController"
            stylesheets="@eco-wow.css"
            styleClass="eco-root"
            prefWidth="1320"
            prefHeight="820">
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="dechet-topbar">
            <VBox spacing="2">
                <Label text="Gestion Déchets" styleClass="dechet-top-title"/>
                <Label text="Signalements, analyse IA, statistiques et documents terrain" styleClass="dechet-top-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#openDashboard" styleClass="secondary-button"/>
            <Button text="+ Nouveau" onAction="#openNew" styleClass="secondary-button"/>
            <Button text="Stats" onAction="#openStats" styleClass="secondary-button"/>
            <Button text="Documents" onAction="#openDocuments" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
