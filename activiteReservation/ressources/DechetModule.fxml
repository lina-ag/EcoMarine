<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DechetModuleController"
            stylesheets="@eco-wow.css"
            prefWidth="1320"
            prefHeight="820">
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-background-color: #061735; -fx-padding: 14 18;">
            <VBox spacing="2">
                <Label text="Module Dechets" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: 900;"/>
                <Label text="Dashboard / New / Stats / Documents" style="-fx-text-fill: #8bdff0; -fx-font-size: 12px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Dashboard" onAction="#openDashboard" styleClass="secondary-button"/>
            <Button text="+ New" onAction="#openNew" styleClass="secondary-button"/>
            <Button text="Stats" onAction="#openStats" styleClass="secondary-button"/>
            <Button text="Documents" onAction="#openDocuments" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
