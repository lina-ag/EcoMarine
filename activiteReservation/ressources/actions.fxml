<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ActionsController"
      spacing="22"
      stylesheets="@eco-wow.css"
      styleClass="eco-root eco-shell"
      prefWidth="1320"
      prefHeight="820">

    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="hero-panel">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <Label text="CENTRE DE NETTOYAGE INTELLIGENT" styleClass="hero-kicker"/>
            <Label text="Planifier les missions, mobiliser les volontaires" styleClass="hero-title"/>
            <Label text="Une vue operationnelle pour suivre les actions, prioriser les zones et afficher les participants d'une mission." wrapText="true" styleClass="hero-subtitle"/>
        </VBox>
        <VBox spacing="10" styleClass="deep-card" prefWidth="280">
            <Label text="Mission du jour" styleClass="mini-title"/>
            <Label text="Balayage plage nord, collecte plastique, tri et verification photo apres intervention." wrapText="true" styleClass="mini-text"/>
            <Label text="Priorite haute" styleClass="chip"/>
        </VBox>
    </HBox>

    <GridPane hgap="18" vgap="18">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox styleClass="metric-card">
            <Label text="12" styleClass="metric-number"/>
            <Label text="Missions ouvertes" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="1">
            <Label text="48" styleClass="metric-number"/>
            <Label text="Volontaires mobilises" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="2">
            <Label text="6" styleClass="metric-number"/>
            <Label text="Zones critiques" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="3">
            <Label text="91%" styleClass="metric-number"/>
            <Label text="Progression terrain" styleClass="metric-label"/>
        </VBox>
    </GridPane>

    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="glass-card">
        <VBox spacing="8">
            <Label text="Date de mission" styleClass="mini-title"/>
            <TextField fx:id="txtDate" promptText="YYYY-MM-DD ou DD/MM/YYYY" prefWidth="250" styleClass="field-wow"/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Lieu cible" styleClass="mini-title"/>
            <TextField fx:id="txtLieu" promptText="Ex: Plage nord, port, zone touristique" maxWidth="Infinity" styleClass="field-wow"/>
        </VBox>
        <VBox spacing="10" alignment="BOTTOM_RIGHT">
            <HBox spacing="10">
                <Button text="Ajouter" onAction="#addAction" styleClass="primary-button"/>
                <Button text="Modifier" onAction="#updateAction" styleClass="secondary-button"/>
                <Button text="Vider" onAction="#clearAction" styleClass="secondary-button"/>
                <Button text="Supprimer" onAction="#deleteAction" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </HBox>

    <GridPane hgap="18" vgap="18" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="72"/>
            <ColumnConstraints percentWidth="28"/>
        </columnConstraints>
        <TableView fx:id="tableActions" prefHeight="430" styleClass="table-wow">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="220"/>
                <TableColumn fx:id="colLieu" text="Lieu" prefWidth="420"/>
                <TableColumn fx:id="colParticipants" text="Participants" prefWidth="180"/>
            </columns>
        </TableView>

        <VBox spacing="14" styleClass="glass-card" GridPane.columnIndex="1">
            <Label text="Plan terrain rapide" styleClass="section-title"/>
            <VBox spacing="10" styleClass="deep-card">
                <Label text="1. Brief" styleClass="mini-title"/>
                <Label text="Confirmer zone, sacs, gants, tri et point de rendez-vous." wrapText="true" styleClass="mini-text"/>
            </VBox>
            <VBox spacing="10" styleClass="deep-card">
                <Label text="2. Collecte" styleClass="mini-title"/>
                <Label text="Photo avant/apres, pesee des sacs, separation plastique/metal/verre." wrapText="true" styleClass="mini-text"/>
            </VBox>
            <VBox spacing="10" styleClass="deep-card">
                <Label text="3. Suivi" styleClass="mini-title"/>
                <Label text="Repasser dans 72h et noter les dechets recurrents." wrapText="true" styleClass="mini-text"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Voir les participants depuis la colonne du tableau." wrapText="true" styleClass="section-caption"/>
        </VBox>
    </GridPane>
</VBox>
