<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AfficherActivite"
      spacing="22"
      stylesheets="@eco-wow.css"
      styleClass="eco-root eco-shell"
      prefWidth="1320"
      prefHeight="820">

    <HBox spacing="18" alignment="CENTER_LEFT" styleClass="hero-panel">
        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <Label text="AGENDA ECO-MARINE" styleClass="hero-kicker"/>
            <Label text="Evenements vivants, utiles et faciles a piloter" styleClass="hero-title"/>
            <Label text="Recherche, filtres rapides, capacite et actions directes dans une interface JavaFX plus immersive." wrapText="true" styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button fx:id="btnBack" text="Retour" onAction="#handleBack" styleClass="secondary-button"/>
                <Button text="+ Ajouter un evenement" onAction="#handleAjouter" styleClass="primary-button"/>
            </HBox>
        </VBox>
        <VBox spacing="12" styleClass="deep-card" prefWidth="310">
            <Label text="Prochain temps fort" styleClass="mini-title"/>
            <Label text="Atelier sensibilisation + nettoyage collectif avec photo avant/apres et suivi volontaires." wrapText="true" styleClass="mini-text"/>
            <Label text="A preparer cette semaine" styleClass="chip"/>
        </VBox>
    </HBox>

    <GridPane hgap="18" vgap="18">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox styleClass="metric-card">
            <Label text="24" styleClass="metric-number"/>
            <Label text="Evenements actifs" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="1">
            <Label text="136" styleClass="metric-number"/>
            <Label text="Places ouvertes" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="2">
            <Label text="8" styleClass="metric-number"/>
            <Label text="Cette semaine" styleClass="metric-label"/>
        </VBox>
        <VBox styleClass="metric-card" GridPane.columnIndex="3">
            <Label text="AI" styleClass="metric-number"/>
            <Label text="Suggestions planning" styleClass="metric-label"/>
        </VBox>
    </GridPane>

    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="glass-card">
        <TextField fx:id="searchField" promptText="Rechercher par nom, description, date ou capacite" HBox.hgrow="ALWAYS" styleClass="field-wow"/>
        <Button fx:id="microphoneButton" text="Micro" onAction="#rechercheVocale" styleClass="secondary-button"/>
        <Button fx:id="searchButton" text="Rechercher" onAction="#handleSearch" styleClass="primary-button"/>
        <Button fx:id="clearButton" text="Effacer" onAction="#clearSearch" styleClass="secondary-button"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Filtres rapides" styleClass="chip"/>
        <Button text="Aujourd'hui" onAction="#filterToday" styleClass="secondary-button"/>
        <Button text="Cette semaine" onAction="#filterThisWeek" styleClass="secondary-button"/>
        <Button text="Ce mois" onAction="#filterThisMonth" styleClass="secondary-button"/>
        <Button text="Capacite > 10" onAction="#filterCapacity" styleClass="secondary-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultCountLabel" text="0 evenement(s)" styleClass="chip"/>
    </HBox>

    <GridPane hgap="18" vgap="18" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="73"/>
            <ColumnConstraints percentWidth="27"/>
        </columnConstraints>

        <TableView fx:id="tableActivite" prefHeight="430" styleClass="table-wow">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="55"/>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="180"/>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="290"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                <TableColumn fx:id="colCapacite" text="Capacite" prefWidth="100"/>
                <TableColumn fx:id="colModifier" text="Modifier" prefWidth="115"/>
                <TableColumn fx:id="colSupprimer" text="Supprimer" prefWidth="115"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <VBox spacing="14" styleClass="glass-card" GridPane.columnIndex="1">
            <Label text="Timeline creative" styleClass="section-title"/>
            <VBox spacing="8" styleClass="deep-card">
                <Label text="Avant" styleClass="mini-title"/>
                <Label text="Invitations, materiel, roles et carte du lieu." wrapText="true" styleClass="mini-text"/>
            </VBox>
            <VBox spacing="8" styleClass="deep-card">
                <Label text="Pendant" styleClass="mini-title"/>
                <Label text="Photos, presence, incidents, meteo et progression." wrapText="true" styleClass="mini-text"/>
            </VBox>
            <VBox spacing="8" styleClass="deep-card">
                <Label text="Apres" styleClass="mini-title"/>
                <Label text="Bilan, points forts, documents et prochain rendez-vous." wrapText="true" styleClass="mini-text"/>
            </VBox>
        </VBox>
    </GridPane>
</VBox>
